# Copy to .env (or fill these in from Settings > Plugins in the app).
# .env is git-ignored. Tokens never leave the local server.

# Jira Cloud
JIRA_BASE_URL=https://your-team.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_USERNAME=
JIRA_API_TOKEN=

# GitHub (GITHUB_TOKEN is optional when the gh CLI is logged in)
GITHUB_USERNAME=
GITHUB_EMAIL=
GITHUB_TOKEN=
